if (!structure(0, 0, 0, "is_floating_cleanup_block", "NONE")) fail;
if (check(0, -1, 0) != "AIR") fail;

str blockID = getBlock(0, 0, 0);

num nearby = 0;

// Same-level neighbours imply this is probably a broken edge of a larger feature,
// not a disposable single-block speck.
if (structure(1, 0, 0, "is_floating_cleanup_block", "NONE")) nearby = nearby + 1;
if (structure(-1, 0, 0, "is_floating_cleanup_block", "NONE")) nearby = nearby + 1;
if (structure(0, 0, 1, "is_floating_cleanup_block", "NONE")) nearby = nearby + 1;
if (structure(0, 0, -1, "is_floating_cleanup_block", "NONE")) nearby = nearby + 1;
if (structure(1, 0, 1, "is_floating_cleanup_block", "NONE")) nearby = nearby + 1;
if (structure(-1, 0, 1, "is_floating_cleanup_block", "NONE")) nearby = nearby + 1;
if (structure(1, 0, -1, "is_floating_cleanup_block", "NONE")) nearby = nearby + 1;
if (structure(-1, 0, -1, "is_floating_cleanup_block", "NONE")) nearby = nearby + 1;
if (structure(2, 0, 0, "is_floating_cleanup_block", "NONE")) nearby = nearby + 1;
if (structure(-2, 0, 0, "is_floating_cleanup_block", "NONE")) nearby = nearby + 1;
if (structure(0, 0, 2, "is_floating_cleanup_block", "NONE")) nearby = nearby + 1;
if (structure(0, 0, -2, "is_floating_cleanup_block", "NONE")) nearby = nearby + 1;

num fillDepth = 0;

if (check(0, -2, 0) == "LAND") fillDepth = 1;
else if (check(0, -3, 0) == "LAND") fillDepth = 2;
else if (check(0, -4, 0) == "LAND") fillDepth = 3;
else if (check(0, -5, 0) == "LAND") fillDepth = 4;

num nearbyAnchor = 0;
if (check(1, -2, 0) == "LAND") nearbyAnchor = nearbyAnchor + 1;
if (check(-1, -2, 0) == "LAND") nearbyAnchor = nearbyAnchor + 1;
if (check(0, -2, 1) == "LAND") nearbyAnchor = nearbyAnchor + 1;
if (check(0, -2, -1) == "LAND") nearbyAnchor = nearbyAnchor + 1;
if (check(2, -3, 0) == "LAND") nearbyAnchor = nearbyAnchor + 1;
if (check(-2, -3, 0) == "LAND") nearbyAnchor = nearbyAnchor + 1;
if (check(0, -3, 2) == "LAND") nearbyAnchor = nearbyAnchor + 1;
if (check(0, -3, -2) == "LAND") nearbyAnchor = nearbyAnchor + 1;

if (nearby >= 2) {
    if (fillDepth > 0) {
        for (num y = 1; y <= fillDepth; y = y + 1) {
            block(0, -y, 0, blockID);
        }
    } else if (nearbyAnchor > 0) {
        block(0, -1, 0, blockID);
    }
    return;
}

// A single unsupported block with no nearby terrain is noise; remove only that block.
if (nearbyAnchor > 0) {
    block(0, -1, 0, blockID);
} else if (check(3, 0, 0) != "LAND" &&
    check(-3, 0, 0) != "LAND" &&
    check(0, 0, 3) != "LAND" &&
    check(0, 0, -3) != "LAND" &&
    check(3, 1, 0) != "LAND" &&
    check(-3, 1, 0) != "LAND" &&
    check(0, 1, 3) != "LAND" &&
    check(0, 1, -3) != "LAND") {
    block(0, 0, 0, "minecraft:air");
}
