if (!structure(0, 0, 0, "is_floating_cleanup_block", "NONE")) fail;
if (check(0, -1, 0) != "AIR") fail;

num support = 0;

// Keep real terrain overhangs. Detached clumps usually have air at this radius.
if (check(6, 0, 0) == "LAND") support = support + 2;
if (check(-6, 0, 0) == "LAND") support = support + 2;
if (check(0, 0, 6) == "LAND") support = support + 2;
if (check(0, 0, -6) == "LAND") support = support + 2;
if (check(6, 1, 0) == "LAND") support = support + 1;
if (check(-6, 1, 0) == "LAND") support = support + 1;
if (check(0, 1, 6) == "LAND") support = support + 1;
if (check(0, 1, -6) == "LAND") support = support + 1;

if (support > 2) fail;

for (num x = -2; x <= 2; x = x + 1) {
    for (num y = 0; y <= 2; y = y + 1) {
        for (num z = -2; z <= 2; z = z + 1) {
            if (pow(x, 2) + pow(y, 2) + pow(z, 2) <= 5 &&
                structure(x, y, z, "is_floating_cleanup_block", "NONE")) {
                block(x, y, z, "minecraft:air");
            }
        }
    }
}
